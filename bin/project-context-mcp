#!/usr/bin/env node
import { existsSync } from 'node:fs';
import { dirname, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { runEntrypointWithSystemCa } from './system-ca.js';

const packageRoot = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const entrypoint = resolve(packageRoot, 'dist', 'mcp', 'server.js');

if (!existsSync(entrypoint)) {
  console.error('[project-context] Compiled MCP server is missing. Run `npm run build` in the router package.');
  process.exit(1);
}

await runEntrypointWithSystemCa(entrypoint);
