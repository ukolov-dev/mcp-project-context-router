{
  "name": "mcp-project-context-router",
  "version": "0.12.0",
  "description": "Tree docs and task-focused context routing for coding agents, with local Markdown/YAML memory and CLI/MCP workflows",
  "license": "UNLICENSED",
  "private": false,
  "author": "ukolov-dev",
  "homepage": "https://github.com/ukolov-dev/mcp-project-context-router#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ukolov-dev/mcp-project-context-router.git"
  },
  "bugs": {
    "url": "https://github.com/ukolov-dev/mcp-project-context-router/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "coding-agents",
    "tree-docs",
    "progressive-disclosure",
    "project-memory",
    "context-management",
    "developer-tools"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "bin",
    "docs",
    "dist",
    "hooks",
    "scripts/macos-portal-credential.js",
    "scripts/windows-confluence-credential.ps1",
    "scripts/windows-portal-credential.ps1",
    "templates",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "README.md"
  ],
  "bin": {
    "project-context": "./bin/project-context",
    "project-context-mcp": "./bin/project-context-mcp",
    "ppm-context": "./bin/ppm-context"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "cli": "node --import tsx src/cli.ts",
    "mcp": "node --import tsx src/mcp/server.ts",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "package:check": "node scripts/package-smoke.mjs",
    "export:standalone": "node scripts/export-standalone.mjs",
    "search:eval": "node --import tsx scripts/search-eval.ts",
    "package:consumer": "node scripts/consumer-smoke.mjs",
    "site:build": "node site/build.mjs",
    "site:check": "node site/check.mjs",
    "site:preview": "vite site/dist --host 127.0.0.1 --port 4179 --strictPort"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "commander": "15.0.0",
    "fast-glob": "3.3.3",
    "gray-matter": "4.0.3",
    "js-yaml": "5.4.3",
    "zod": "4.6.7",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "marked": "18.1.1",
    "tsx": "4.23.15",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "publishConfig": {
    "tag": "dev"
  }
}
